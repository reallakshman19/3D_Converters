{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/node-history/schemas/PsiNodeZoneRegistry.v1.schema.json",
  "title": "PsiNodeZoneRegistry.v1",
  "type": "object",
  "required": [
    "schema", "registryVersion", "projectId", "zoneId", "policyVersion",
    "configVersion", "namespace", "leases", "lineHistoryRefs", "validation", "zoneRegistryHash"
  ],
  "properties": {
    "schema": {"const": "PsiNodeZoneRegistry.v1"},
    "registryVersion": {"const": "1.0.0"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "policyVersion": {"type": "string", "minLength": 1},
    "configVersion": {"type": "string", "minLength": 1},
    "namespace": {"$ref": "#/$defs/namespace"},
    "leases": {"type": "array", "items": {"$ref": "#/$defs/lease"}},
    "lineHistoryRefs": {"type": "array", "items": {"$ref": "#/$defs/lineHistoryRef"}},
    "coordinateRegistrationRefs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "validation": {"$ref": "#/$defs/validation"},
    "zoneRegistryHash": {"$ref": "#/$defs/hash"},
    "audit": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "mainLineKey": {"type": "string", "pattern": "^/[A-Z0-9][A-Z0-9._-]*(/[A-Z0-9][A-Z0-9._-]*)*$"},
    "namespace": {
      "type": "object",
      "required": ["minimum", "maximum", "defaultStep"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 0},
        "maximum": {"type": "integer", "minimum": 0},
        "defaultStep": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": ["start", "end", "step"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "step": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "leaseEvidence": {
      "type": "object",
      "required": ["authority", "revisionId"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "revisionId": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "lease": {
      "type": "object",
      "required": ["leaseId", "mainLineKey", "status", "ranges", "firstObservedRevision", "lastObservedRevision", "evidence"],
      "properties": {
        "leaseId": {"type": "string", "minLength": 1},
        "mainLineKey": {"$ref": "#/$defs/mainLineKey"},
        "status": {"enum": ["ACTIVE", "RETIRED"]},
        "ranges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/range"}},
        "firstObservedRevision": {"type": "string", "minLength": 1},
        "lastObservedRevision": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/leaseEvidence"}
      },
      "additionalProperties": false
    },
    "lineHistoryRef": {
      "type": "object",
      "required": ["mainLineKey", "path", "lineHistoryHash"],
      "properties": {
        "mainLineKey": {"$ref": "#/$defs/mainLineKey"},
        "path": {"type": "string", "minLength": 1},
        "lineHistoryHash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {
        "status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]},
        "blockers": {"type": "array"},
        "reviewItems": {"type": "array"},
        "warnings": {"type": "array"}
      },
      "additionalProperties": false
    }
  }
}
