{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/TopoNodePlan.v1.schema.json",
  "title": "TopoNodePlan.v1",
  "type": "object",
  "required": ["schema", "projectId", "zoneId", "sourceInventoryHash", "logicalTopologyHash", "sequencePlanHash", "baseRegistrySnapshotHash", "configHash", "logicalNodes", "emittedOccurrences", "reservedOccurrences", "rawPortMappings", "componentProjection", "validation", "nodePlanHash"],
  "properties": {
    "schema": {"const": "TopoNodePlan.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "sourceInventoryHash": {"type": "string", "minLength": 1},
    "logicalTopologyHash": {"type": "string", "minLength": 1},
    "sequencePlanHash": {"type": "string", "minLength": 1},
    "baseRegistrySnapshotHash": {"type": "string", "minLength": 1},
    "configHash": {"type": "string", "minLength": 1},
    "logicalNodes": {"type": "array", "items": {"$ref": "#/$defs/logicalNode"}},
    "emittedOccurrences": {"type": "array", "items": {"$ref": "#/$defs/nodePlanOccurrence"}},
    "reservedOccurrences": {"type": "array", "items": {"$ref": "#/$defs/nodePlanOccurrence"}},
    "rawPortMappings": {"type": "array", "items": {"$ref": "#/$defs/rawPortMapping"}},
    "componentProjection": {"type": "array", "items": {"$ref": "#/$defs/componentProjection"}},
    "validation": {"$ref": "#/$defs/validation"},
    "nodePlanHash": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true,
  "allOf": [{"$ref": "#/$defs/noRelativeNumberFields"}],
  "$defs": {
    "componentProjection": {
      "type": "object",
      "required": ["componentProjectionId", "sourceEntityId", "emittedOccurrenceIds", "reservedOccurrenceIds"],
      "properties": {"componentProjectionId": {"type": "string", "minLength": 1}, "sourceEntityId": {"type": "string", "minLength": 1}, "emittedOccurrenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "reservedOccurrenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}},
      "additionalProperties": true
    },
    "logicalNode": {"type": "object", "required": ["logicalNodeId"], "properties": {"logicalNodeId": {"type": "string", "minLength": 1}, "historyNodeId": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "noRelativeNumberFields": {
      "if": {"type": "object"},
      "then": {"propertyNames": {"not": {"enum": ["offset", "numberOffset", "nodeOffset", "derivedFromOccurrenceId", "startNodeNumber", "nodeCounter", "numberingSpan", "increment", "relativeTo", "baseNodeNumber"]}}, "additionalProperties": {"$ref": "#/$defs/noRelativeNumberFields"}},
      "else": {"if": {"type": "array"}, "then": {"items": {"$ref": "#/$defs/noRelativeNumberFields"}}}
    },
    "nodePlanOccurrence": {
      "type": "object",
      "required": ["occurrenceId", "logicalNodeId", "componentProjectionId", "engineeringNodeNumber"],
      "properties": {"occurrenceId": {"type": "string", "minLength": 1}, "logicalNodeId": {"type": "string", "minLength": 1}, "historyNodeId": {"type": "string", "minLength": 1}, "componentProjectionId": {"type": "string", "minLength": 1}, "engineeringNodeNumber": {"type": "integer", "minimum": 0}},
      "additionalProperties": true
    },
    "rawPortMapping": {"type": "object", "required": ["sourcePortId", "logicalNodeId"], "properties": {"sourcePortId": {"type": "string", "minLength": 1}, "logicalNodeId": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
