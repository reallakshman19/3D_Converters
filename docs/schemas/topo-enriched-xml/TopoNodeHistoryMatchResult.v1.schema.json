{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/TopoNodeHistoryMatchResult.v1.schema.json",
  "title": "TopoNodeHistoryMatchResult.v1",
  "type": "object",
  "required": ["schema", "projectId", "zoneId", "mainLineKey", "coordinateFrameId", "logicalTopologyHash", "baseRegistrySnapshotHash", "matches", "newNodes", "ambiguous", "conflicts", "reactivated", "retirementCandidates", "validation"],
  "properties": {
    "schema": {"const": "TopoNodeHistoryMatchResult.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "mainLineKey": {"type": "string", "minLength": 1},
    "coordinateFrameId": {"type": "string", "minLength": 1},
    "logicalTopologyHash": {"type": "string", "minLength": 1},
    "baseRegistrySnapshotHash": {"type": "string", "minLength": 1},
    "matches": {"type": "array", "items": {"$ref": "#/$defs/historyMatch"}},
    "newNodes": {"type": "array", "items": {"type": "object"}},
    "ambiguous": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "reactivated": {"type": "array", "items": {"type": "object"}},
    "retirementCandidates": {"type": "array", "items": {"type": "object"}},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "additionalProperties": true,
  "$defs": {
    "historyMatch": {"type": "object", "required": ["logicalNodeId", "historyNodeId"], "properties": {"logicalNodeId": {"type": "string", "minLength": 1}, "historyNodeId": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
