{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/TopoEnrichedXmlValidationReport.v1.schema.json",
  "title": "TopoEnrichedXmlValidationReport.v1",
  "type": "object",
  "required": ["schema", "projectId", "zoneId", "operatingMode", "sourceInventoryHash", "logicalTopologyHash", "sequencePlanHash", "nodePlanHash", "gates", "issues", "validation"],
  "properties": {
    "schema": {"const": "TopoEnrichedXmlValidationReport.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "operatingMode": {"enum": ["LEGACY", "SHADOW", "REVIEW", "ENFORCED"]},
    "sourceInventoryHash": {"type": "string", "minLength": 1},
    "logicalTopologyHash": {"type": "string", "minLength": 1},
    "sequencePlanHash": {"type": "string", "minLength": 1},
    "nodePlanHash": {"type": "string", "minLength": 1},
    "gates": {"type": "object"},
    "issues": {"type": "array", "items": {"type": "object"}},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "additionalProperties": true,
  "$defs": {
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
