{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/PsiWriterOccurrencePlan.v1.schema.json",
  "title": "PsiWriterOccurrencePlan.v1",
  "type": "object",
  "required": ["schema", "projectId", "zoneId", "sourceInventoryHash", "logicalTopologyHash", "sequencePlanHash", "occurrences", "componentProjection", "validation", "occurrencePlanHash"],
  "properties": {
    "schema": {"const": "PsiWriterOccurrencePlan.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "sourceInventoryHash": {"type": "string", "minLength": 1},
    "logicalTopologyHash": {"type": "string", "minLength": 1},
    "sequencePlanHash": {"type": "string", "minLength": 1},
    "occurrences": {"type": "array", "items": {"$ref": "#/$defs/psiWriterOccurrenceBody"}},
    "componentProjection": {"type": "array", "items": {"$ref": "#/$defs/occurrenceProjection"}},
    "validation": {"$ref": "#/$defs/validation"},
    "occurrencePlanHash": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true,
  "$defs": {
    "occurrenceProjection": {"type": "object", "required": ["componentProjectionId", "occurrenceIds"], "properties": {"componentProjectionId": {"type": "string", "minLength": 1}, "occurrenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}, "additionalProperties": true},
    "psiWriterOccurrenceBody": {
      "type": "object",
      "required": ["occurrenceId", "sourceEntityId", "sourceBranch", "canonicalMainLine", "componentProjectionId", "projectionRole", "endpoint", "psiComponentType", "coordinateRole", "disposition"],
      "properties": {
        "schema": {"const": "PsiWriterOccurrence.v1"},
        "occurrenceId": {"type": "string", "minLength": 1},
        "logicalNodeId": {"type": "string", "minLength": 1},
        "sourceEntityId": {"type": "string", "minLength": 1},
        "sourceRecordId": {"type": "string", "minLength": 1},
        "sourceBranch": {"type": "string", "minLength": 1},
        "canonicalMainLine": {"type": "string", "minLength": 1},
        "componentProjectionId": {"type": "string", "minLength": 1},
        "projectionRole": {"type": "string", "minLength": 1},
        "endpoint": {"type": ["integer", "string"]},
        "psiComponentType": {"type": "string", "minLength": 1},
        "rawComponentType": {"type": "string", "minLength": 1},
        "normalizedComponentType": {"type": "string", "minLength": 1},
        "coordinateRole": {"type": "string", "minLength": 1},
        "coordinateEvidence": {"type": "object"},
        "orderingEvidence": {"type": "object"},
        "disposition": {"enum": ["EMITTED", "RESERVED"]}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
