{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/TopoLogicalGraph.v1.schema.json",
  "title": "TopoLogicalGraph.v1",
  "type": "object",
  "required": ["schema", "projectId", "zoneId", "coordinateFrameId", "sourceInventoryHash", "nodes", "edges", "junctions", "boundaries", "supports", "validation"],
  "properties": {
    "schema": {"const": "TopoLogicalGraph.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "coordinateFrameId": {"type": "string", "minLength": 1},
    "sourceInventoryHash": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/logicalNode"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/logicalEdge"}},
    "junctions": {"type": "array", "items": {"type": "object"}},
    "boundaries": {"type": "array", "items": {"type": "object"}},
    "supports": {"type": "array", "items": {"type": "object"}},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "additionalProperties": true,
  "$defs": {
    "logicalEdge": {"type": "object", "required": ["logicalEdgeId", "fromLogicalNodeId", "toLogicalNodeId"], "properties": {"logicalEdgeId": {"type": "string", "minLength": 1}, "fromLogicalNodeId": {"type": "string", "minLength": 1}, "toLogicalNodeId": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "logicalNode": {"type": "object", "required": ["logicalNodeId"], "properties": {"logicalNodeId": {"type": "string", "minLength": 1}, "historyNodeId": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
