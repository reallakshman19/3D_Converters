name: Issue 781 Regex Master Evidence Validation

on:
  pull_request:
    branches: [main]
    paths:
      - 'tabs/xml-cii-2019-standalone/xml-cii-regex-smart-suggestions.js'
      - 'tabs/xml-cii-2019-standalone/ui-adapted/xml-cii-adapted-regex-smart-evidence.js'
      - 'tabs/xml-cii-2019-standalone/ui-adapted/xml-cii-adapted-regex-smart-ui.js'
      - 'tabs/xml-cii-2019-standalone/ui-adapted/xml-cii-adapted-regex-tester.js'
      - 'docs/tabs/xml-cii-2019-standalone/xml-cii-regex-smart-suggestions.js'
      - 'docs/tabs/xml-cii-2019-standalone/ui-adapted/xml-cii-adapted-regex-smart-evidence.js'
      - 'docs/tabs/xml-cii-2019-standalone/ui-adapted/xml-cii-adapted-regex-smart-ui.js'
      - 'docs/tabs/xml-cii-2019-standalone/ui-adapted/xml-cii-adapted-regex-tester.js'
      - 'tests/xml-cii-issue-781-regex-master-evidence.test.mjs'
      - 'tests/xml-cii-issue-781-live-regex-acceptance.test.mjs'
      - 'tests/xml-cii-j04-multi-format-preview.test.mjs'
      - 'tests/xml-cii-j04-shared-branch-extraction.test.mjs'
      - 'tests/xml-cii-j04-mode-a-provenance.test.mjs'
      - 'tests/xml-cii-j04-output-authority-readiness.test.mjs'
      - 'converters/xml-cii2019-core/branch-format-extraction.js'
      - 'docs/converters/xml-cii2019-core/branch-format-extraction.js'
      - 'tests/browser/xml-cii-issue-781-live-regex-acceptance.html'
      - 'tests/xml-cii-issue-781-live-regex-browser.mjs'
      - 'scripts/run-xml-cii-regex-bounded-evidence-scale-e2e.mjs'
      - 'tests/browser/xml-cii-regex-bounded-evidence-scale-e2e.html'
      - '.github/workflows/issue-781-regex-master-evidence.yml'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  regex-master-evidence:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact PR head
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Run Issue 781 regex master evidence regression
        run: >-
          node --test
          tests/xml-cii-issue-781-regex-master-evidence.test.mjs
          tests/xml-cii-issue-781-live-regex-acceptance.test.mjs
          tests/xml-cii-j04-multi-format-preview.test.mjs
          tests/xml-cii-j04-shared-branch-extraction.test.mjs
          tests/xml-cii-j04-mode-a-provenance.test.mjs
          tests/xml-cii-j04-output-authority-readiness.test.mjs

      - name: Run existing smart regex regressions
        run: >-
          node --test
          tests/xml-cii-smart-ui-preflight.test.mjs
          tests/xml-cii-regex-confidence-buckets.test.mjs
          tests/xml-cii-issue-776-regex-index-cache.test.mjs

      - name: Run PR780 dataset regression
        run: node --test tests/xml-cii-master-dataset-coordinator.test.mjs

  regex-bounded-evidence-scale:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact PR head
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Install Playwright Chromium
        run: |
          npm install --no-save --ignore-scripts playwright@1.52.0
          npx playwright install --with-deps chromium

      - name: Start static server
        run: |
          python3 -m http.server 4173 --bind 127.0.0.1 > /tmp/issue-923-j02-http.log 2>&1 &

      - name: Run J03 live Regex token interaction browser acceptance
        run: node tests/xml-cii-issue-781-live-regex-browser.mjs

      - name: Run J02 10k / 50k / 100k bounded evidence browser scale
        run: node scripts/run-xml-cii-regex-bounded-evidence-scale-e2e.mjs

      - name: Upload J02 bounded evidence scale
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: issue-923-j02-regex-bounded-evidence-scale
          path: |
            ValidationRecords/xml-cii-regex-bounded-evidence-scale.json
            /tmp/issue-923-j02-http.log
          if-no-files-found: warn

