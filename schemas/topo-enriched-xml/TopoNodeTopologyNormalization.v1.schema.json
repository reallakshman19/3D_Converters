{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/TopoNodeTopologyNormalization.v1.schema.json",
  "title": "TopoNodeTopologyNormalization.v1",
  "type": "object",
  "required": ["schema", "projectId", "zoneId", "sourceInventoryHash", "inputLogicalTopologyHash", "outputLogicalTopologyHash", "rawPortMappings", "actions", "validation"],
  "properties": {
    "schema": {"const": "TopoNodeTopologyNormalization.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "sourceInventoryHash": {"type": "string", "minLength": 1},
    "inputLogicalTopologyHash": {"type": "string", "minLength": 1},
    "outputLogicalTopologyHash": {"type": "string", "minLength": 1},
    "rawPortMappings": {"type": "array", "items": {"$ref": "#/$defs/rawPortMapping"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/normalizationAction"}},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "additionalProperties": true,
  "$defs": {
    "normalizationAction": {"type": "object", "required": ["actionId", "disposition"], "properties": {"actionId": {"type": "string", "minLength": 1}, "disposition": {"enum": ["PRESERVE", "CONSUME_MICRO_COMPONENT", "SNAP_MICRO_GAP", "BLOCKED_CONFLICT", "REVIEW_REQUIRED"]}, "authority": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "rawPortMapping": {"type": "object", "required": ["sourcePortId", "logicalNodeId"], "properties": {"sourcePortId": {"type": "string", "minLength": 1}, "logicalNodeId": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
