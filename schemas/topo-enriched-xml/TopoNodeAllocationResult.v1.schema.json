{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/TopoNodeAllocationResult.v1.schema.json",
  "title": "TopoNodeAllocationResult.v1",
  "type": "object",
  "required": ["schema", "projectId", "zoneId", "baseRegistrySnapshotHash", "historyMatchResultHash", "leases", "allocations", "retirements", "reactivations", "validation"],
  "properties": {
    "schema": {"const": "TopoNodeAllocationResult.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "baseRegistrySnapshotHash": {"type": "string", "minLength": 1},
    "historyMatchResultHash": {"type": "string", "minLength": 1},
    "leases": {"type": "array", "items": {"$ref": "#/$defs/lease"}},
    "allocations": {"type": "array", "items": {"$ref": "#/$defs/allocation"}},
    "retirements": {"type": "array", "items": {"type": "object"}},
    "reactivations": {"type": "array", "items": {"type": "object"}},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "additionalProperties": true,
  "$defs": {
    "allocation": {"type": "object", "required": ["engineeringNodeNumber"], "properties": {"logicalNodeId": {"type": "string", "minLength": 1}, "historyNodeId": {"type": "string", "minLength": 1}, "engineeringNodeNumber": {"type": "integer", "minimum": 0}}, "additionalProperties": true},
    "lease": {"type": "object", "required": ["leaseId", "mainLineKey", "start", "end", "step"], "properties": {"leaseId": {"type": "string", "minLength": 1}, "mainLineKey": {"type": "string", "minLength": 1}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}, "step": {"type": "integer", "minimum": 1}}, "additionalProperties": true},
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
