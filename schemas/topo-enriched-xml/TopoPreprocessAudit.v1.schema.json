{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/TopoPreprocessAudit.v1.schema.json",
  "title": "TopoPreprocessAudit.v1",
  "type": "object",
  "required": ["schema", "runId", "projectId", "zoneId", "sourceHash", "configHash", "baseRegistrySnapshotHash", "evaluatedAt", "summary", "actions", "validation"],
  "properties": {
    "schema": {"const": "TopoPreprocessAudit.v1"},
    "runId": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "sourceHash": {"type": "string", "minLength": 1},
    "configHash": {"type": "string", "minLength": 1},
    "baseRegistrySnapshotHash": {"type": "string", "minLength": 1},
    "evaluatedAt": {"type": "string", "minLength": 1},
    "summary": {"type": "object"},
    "actions": {"type": "array", "items": {"type": "object", "required": ["actionId", "type"], "properties": {"actionId": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "additionalProperties": true,
  "$defs": {
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
