{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/TopoSourceInventory.v1.schema.json",
  "title": "TopoSourceInventory.v1",
  "type": "object",
  "required": ["schema", "projectId", "zoneId", "coordinateFrameId", "sourceIdentity", "branches", "entities", "ports", "validation"],
  "properties": {
    "schema": {"const": "TopoSourceInventory.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "coordinateFrameId": {"type": "string", "minLength": 1},
    "sourceIdentity": {"type": "object"},
    "branches": {"type": "array", "items": {"$ref": "#/$defs/sourceBranch"}},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/sourceEntity"}},
    "ports": {"type": "array", "items": {"$ref": "#/$defs/sourcePort"}},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "additionalProperties": true,
  "$defs": {
    "sourceBranch": {"type": "object", "required": ["sourceBranch"], "properties": {"sourceBranch": {"type": "string", "minLength": 1}, "canonicalMainLine": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "sourceEntity": {"type": "object", "required": ["sourceEntityId"], "properties": {"sourceEntityId": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "sourcePort": {"type": "object", "required": ["sourcePortId", "sourceEntityId"], "properties": {"sourcePortId": {"type": "string", "minLength": 1}, "sourceEntityId": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
