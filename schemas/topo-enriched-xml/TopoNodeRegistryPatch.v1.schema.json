{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/TopoNodeRegistryPatch.v1.schema.json",
  "title": "TopoNodeRegistryPatch.v1",
  "type": "object",
  "required": ["schema", "projectId", "zoneId", "baseRegistryCommit", "baseRegistrySnapshotHash", "coverage", "preconditions", "operations", "validation", "proposedRegistryHash"],
  "properties": {
    "schema": {"const": "TopoNodeRegistryPatch.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "baseRegistryCommit": {"type": "string", "minLength": 1},
    "baseRegistrySnapshotHash": {"type": "string", "minLength": 1},
    "coverage": {"type": "object", "required": ["scope", "authoritativeForRetirement"], "properties": {"scope": {"enum": ["FULL_ZONE", "FULL_LINE", "PARTIAL_LINE"]}, "authoritativeForRetirement": {"type": "boolean"}}, "additionalProperties": true},
    "preconditions": {"type": "array", "items": {"type": "object"}},
    "operations": {"type": "array", "items": {"type": "object", "required": ["operationId", "type"], "properties": {"operationId": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "validation": {"$ref": "#/$defs/validation"},
    "proposedRegistryHash": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true,
  "$defs": {
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
