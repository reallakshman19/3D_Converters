{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/PsiWriterParityReport.v2.schema.json",
  "title": "PsiWriterParityReport.v2",
  "type": "object",
  "required": ["schema", "projectId", "zoneId", "nodePlanHash", "occurrencePlanHash", "canonical", "sequential", "differences", "gates", "validation"],
  "properties": {
    "schema": {"const": "PsiWriterParityReport.v2"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "nodePlanHash": {"type": "string", "minLength": 1},
    "occurrencePlanHash": {"type": "string", "minLength": 1},
    "canonical": {"$ref": "#/$defs/paritySide"},
    "sequential": {"$ref": "#/$defs/paritySide"},
    "differences": {"type": "array", "items": {"type": "object"}},
    "gates": {"$ref": "#/$defs/parityGates"},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {"properties": {"validation": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}}, "required": ["validation"]},
      "then": {
        "properties": {
          "differences": {"maxItems": 0},
          "gates": {
            "properties": {
              "nodePlanHashEquivalent": {"const": true},
              "occurrencePlanHashEquivalent": {"const": true},
              "occurrenceIdentityEquivalent": {"const": true},
              "componentProjectionEquivalent": {"const": true},
              "endpointSemanticsEquivalent": {"const": true},
              "engineeringContentEquivalent": {"const": true},
              "sourceBoundaryEquivalent": {"const": true},
              "branchConditionsEquivalent": {"const": true},
              "traceIdentityEquivalent": {"const": true},
              "traceCardinalityEquivalent": {"const": true},
              "reservedOccurrenceTreatmentEquivalent": {"const": true},
              "numberingEquivalent": {"const": true},
              "atomicBundleCoherent": {"const": true},
              "occurrenceCoverage": {"const": 100},
              "reservedOccurrenceCoverage": {"const": 100},
              "writerSideAllocations": {"const": 0},
              "unplannedOccurrences": {"const": 0}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "parityGates": {
      "type": "object",
      "required": [
        "nodePlanHashEquivalent", "occurrencePlanHashEquivalent", "occurrenceIdentityEquivalent",
        "componentProjectionEquivalent", "endpointSemanticsEquivalent", "engineeringContentEquivalent",
        "sourceBoundaryEquivalent", "branchConditionsEquivalent", "traceIdentityEquivalent",
        "traceCardinalityEquivalent", "reservedOccurrenceTreatmentEquivalent", "numberingEquivalent",
        "atomicBundleCoherent", "occurrenceCoverage", "reservedOccurrenceCoverage",
        "writerSideAllocations", "unplannedOccurrences"
      ],
      "properties": {
        "nodePlanHashEquivalent": {"type": "boolean"},
        "occurrencePlanHashEquivalent": {"type": "boolean"},
        "occurrenceIdentityEquivalent": {"type": "boolean"},
        "componentProjectionEquivalent": {"type": "boolean"},
        "endpointSemanticsEquivalent": {"type": "boolean"},
        "engineeringContentEquivalent": {"type": "boolean"},
        "sourceBoundaryEquivalent": {"type": "boolean"},
        "branchConditionsEquivalent": {"type": "boolean"},
        "traceIdentityEquivalent": {"type": "boolean"},
        "traceCardinalityEquivalent": {"type": "boolean"},
        "reservedOccurrenceTreatmentEquivalent": {"type": "boolean"},
        "numberingEquivalent": {"type": "boolean"},
        "atomicBundleCoherent": {"type": "boolean"},
        "occurrenceCoverage": {"type": "integer", "minimum": 0},
        "reservedOccurrenceCoverage": {"type": "integer", "minimum": 0},
        "writerSideAllocations": {"type": "integer", "minimum": 0},
        "unplannedOccurrences": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "paritySide": {
      "type": "object",
      "required": ["nodePlanHash", "occurrencePlanHash", "xmlHash", "traceHash", "bundleHash", "emittedOccurrenceCount", "reservedOccurrenceCount"],
      "properties": {
        "nodePlanHash": {"type": "string", "minLength": 1},
        "occurrencePlanHash": {"type": "string", "minLength": 1},
        "xmlHash": {"type": "string", "minLength": 1},
        "traceHash": {"type": "string", "minLength": 1},
        "bundleHash": {"type": "string", "minLength": 1},
        "emittedOccurrenceCount": {"type": "integer", "minimum": 0},
        "reservedOccurrenceCount": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
