{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reallaksh19.github.io/3D_Converters/schemas/topo-enriched-xml/TopoSequencePlan.v1.schema.json",
  "title": "TopoSequencePlan.v1",
  "type": "object",
  "required": ["schema", "projectId", "zoneId", "sourceInventoryHash", "logicalTopologyHash", "branches", "components", "validation"],
  "properties": {
    "schema": {"const": "TopoSequencePlan.v1"},
    "projectId": {"type": "string", "minLength": 1},
    "zoneId": {"type": "string", "minLength": 1},
    "sourceInventoryHash": {"type": "string", "minLength": 1},
    "logicalTopologyHash": {"type": "string", "minLength": 1},
    "branches": {"type": "array", "items": {"$ref": "#/$defs/sequenceBranch"}},
    "components": {"type": "array", "items": {"$ref": "#/$defs/sequenceComponent"}},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "additionalProperties": true,
  "$defs": {
    "sequenceBranch": {"type": "object", "required": ["sourceBranch", "canonicalMainLine"], "properties": {"sourceBranch": {"type": "string", "minLength": 1}, "canonicalMainLine": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "sequenceComponent": {"type": "object", "required": ["sourceEntityId", "sourceBranch"], "properties": {"sourceEntityId": {"type": "string", "minLength": 1}, "sourceBranch": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "validation": {
      "type": "object",
      "required": ["status", "blockers", "reviewItems", "warnings"],
      "properties": {"status": {"enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED"]}, "blockers": {"type": "array"}, "reviewItems": {"type": "array"}, "warnings": {"type": "array"}},
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"maxItems": 0}, "reviewItems": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}}
      ]
    }
  }
}
