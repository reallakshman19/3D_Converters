{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FbxMappingReviewShard.v1",
  "title": "FbxMappingReviewShard.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundleId",
    "worklistId",
    "sourceGraphCanonicalSha256",
    "shardId",
    "ordinal",
    "workItems"
  ],
  "properties": {
    "schema": {
      "const": "FbxMappingReviewShard.v1"
    },
    "bundleId": {
      "$ref": "#/$defs/sha256"
    },
    "worklistId": {
      "$ref": "#/$defs/sha256"
    },
    "sourceGraphCanonicalSha256": {
      "$ref": "#/$defs/sha256"
    },
    "shardId": {
      "$ref": "#/$defs/sha256"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "workItems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workItem"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "occurrenceId": {
      "type": "string",
      "pattern": "^occ:\\d+$"
    },
    "typeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ufbxElementId",
        "ufbxTypedId",
        "ufbxElementType",
        "ufbxElementTypeValue",
        "nodeAttributeType",
        "nodeAttributeTypeValue",
        "sourceDocumentOrder"
      ],
      "properties": {
        "ufbxElementId": {
          "type": "integer",
          "minimum": 0
        },
        "ufbxTypedId": {
          "type": "integer",
          "minimum": 0
        },
        "ufbxElementType": {
          "type": "string",
          "minLength": 1
        },
        "ufbxElementTypeValue": {
          "type": "integer",
          "minimum": 0
        },
        "nodeAttributeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "nodeAttributeTypeValue": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sourceDocumentOrder": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nameEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "domClass",
        "domSubtype",
        "domSourceName",
        "displayName"
      ],
      "properties": {
        "authority": {
          "const": "NON_AUTHORITATIVE"
        },
        "domClass": {
          "type": "string",
          "minLength": 1
        },
        "domSubtype": {
          "type": "string"
        },
        "domSourceName": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "geometryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometryObjectId",
        "kind",
        "pointAuthority",
        "governedPointCount"
      ],
      "properties": {
        "geometryObjectId": {
          "$ref": "#/$defs/sourceId"
        },
        "kind": {
          "enum": [
            "MESH",
            "NURBS_CURVE"
          ]
        },
        "pointAuthority": {
          "enum": [
            "MESH_VERTEX",
            "NURBS_CONTROL_POINT"
          ]
        },
        "governedPointCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "MESH"
              }
            }
          },
          "then": {
            "properties": {
              "pointAuthority": {
                "const": "MESH_VERTEX"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "NURBS_CURVE"
              }
            }
          },
          "then": {
            "properties": {
              "pointAuthority": {
                "const": "NURBS_CONTROL_POINT"
              }
            }
          }
        }
      ]
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemId",
        "sourceModelObjectId",
        "sourceOccurrenceId",
        "sourceGeometryObjectIds",
        "typeEvidence",
        "nameEvidence",
        "sourceRecordDisposition",
        "geometryEvidence",
        "reviewState"
      ],
      "properties": {
        "workItemId": {
          "type": "string",
          "pattern": "^work-[0-9a-f]{64}$"
        },
        "sourceModelObjectId": {
          "$ref": "#/$defs/sourceId"
        },
        "sourceOccurrenceId": {
          "$ref": "#/$defs/occurrenceId"
        },
        "sourceGeometryObjectIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceId"
          },
          "uniqueItems": true
        },
        "typeEvidence": {
          "$ref": "#/$defs/typeEvidence"
        },
        "nameEvidence": {
          "$ref": "#/$defs/nameEvidence"
        },
        "sourceRecordDisposition": {
          "const": "supported-occurrence"
        },
        "geometryEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/geometryEvidence"
          }
        },
        "reviewState": {
          "const": "PENDING"
        }
      }
    }
  }
}
