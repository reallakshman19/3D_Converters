{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FbxSolidFittingPortEvidence.v2",
  "title": "FbxSolidFittingPortEvidence.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifactId",
    "sourceZoneGeometryArtifactId",
    "toleranceProfile",
    "occurrenceCount",
    "admittedOccurrenceCount",
    "rejectedOccurrenceCount",
    "rejectionCounts",
    "occurrenceEvidence"
  ],
  "properties": {
    "schema": {
      "const": "FbxSolidFittingPortEvidence.v2"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^fbx-solid-fitting-port-evidence:[0-9a-f]{64}$"
    },
    "sourceZoneGeometryArtifactId": {
      "type": "string",
      "pattern": "^fbx-zone-geometry-evidence:[0-9a-f]{64}$"
    },
    "toleranceProfile": {
      "$ref": "#/$defs/toleranceProfile"
    },
    "occurrenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "admittedOccurrenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "rejectedOccurrenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "rejectionCounts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "occurrenceEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/occurrenceRecord"
      }
    }
  },
  "$defs": {
    "toleranceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "planarJoinDotTolerance",
        "minimumRegionAreaRatio",
        "coAxialDotTolerance",
        "radiusTaperRatio",
        "shortSpanRadiusRatio",
        "minimumSpanMm",
        "radiusAbsoluteMm",
        "radiusRatio",
        "vertexMergeAbsoluteMm",
        "vertexMergeRelativeTolerance",
        "maximumPortsPerOccurrence"
      ],
      "properties": {
        "schema": {
          "const": "FbxSolidFittingPortProfile.v2"
        },
        "planarJoinDotTolerance": {
          "const": 0.999
        },
        "minimumRegionAreaRatio": {
          "const": 0.75
        },
        "coAxialDotTolerance": {
          "const": 0.01
        },
        "radiusTaperRatio": {
          "const": 0.05
        },
        "shortSpanRadiusRatio": {
          "const": 1.5
        },
        "minimumSpanMm": {
          "const": 0.000001
        },
        "radiusAbsoluteMm": {
          "const": 0.05
        },
        "radiusRatio": {
          "const": 0.001
        },
        "vertexMergeAbsoluteMm": {
          "const": 0.000002
        },
        "vertexMergeRelativeTolerance": {
          "const": 0
        },
        "maximumPortsPerOccurrence": {
          "const": 4
        }
      }
    },
    "analysisProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "toleranceMm",
        "sourceVertexCount",
        "analysisVertexCount",
        "mergedVertexCount",
        "maximumMergeResidualMm",
        "sourceFaceCount",
        "analysisFaceCount",
        "degenerateFaceIds",
        "duplicateFaceIds",
        "vertexGroups"
      ],
      "properties": {
        "method": {
          "const": "POSITION_WELD_AND_FACE_DEDUP_V1"
        },
        "toleranceMm": {
          "const": 0.000002
        },
        "sourceVertexCount": {
          "type": "integer",
          "minimum": 0
        },
        "analysisVertexCount": {
          "type": "integer",
          "minimum": 0
        },
        "mergedVertexCount": {
          "type": "integer",
          "minimum": 0
        },
        "maximumMergeResidualMm": {
          "type": "number",
          "minimum": 0
        },
        "sourceFaceCount": {
          "type": "integer",
          "minimum": 0
        },
        "analysisFaceCount": {
          "type": "integer",
          "minimum": 0
        },
        "degenerateFaceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicateFaceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vertexGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "analysisVertexIndex",
              "sourceVertexIndices"
            ],
            "properties": {
              "analysisVertexIndex": {
                "type": "integer",
                "minimum": 0
              },
              "sourceVertexIndices": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capRingId",
        "portEvidenceId",
        "boundaryLoopId",
        "sourceOccurrenceId",
        "geometryObjectId",
        "shellId",
        "faceIds",
        "centreMm",
        "normal",
        "radiusMm",
        "diameterMm",
        "innerRadiusMm",
        "admissionDisposition",
        "rejectionReasons"
      ],
      "properties": {
        "capRingId": {
          "type": "string",
          "pattern": "^cap-ring:[0-9a-f]{64}$"
        },
        "portEvidenceId": {
          "type": "string",
          "pattern": "^cap-ring:[0-9a-f]{64}$"
        },
        "boundaryLoopId": {
          "type": "string",
          "pattern": "^cap-ring:[0-9a-f]{64}$"
        },
        "sourceOccurrenceId": {
          "type": "string",
          "pattern": "^occ:[0-9]+$"
        },
        "geometryObjectId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "shellId": {
          "type": "string",
          "pattern": "^shell:[0-9a-f]{64}$"
        },
        "faceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "centreMm": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "normal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "radiusMm": {
          "type": [
            "number",
            "null"
          ]
        },
        "diameterMm": {
          "type": [
            "number",
            "null"
          ]
        },
        "innerRadiusMm": {
          "type": [
            "number",
            "null"
          ]
        },
        "admissionDisposition": {
          "enum": [
            "ADMITTED",
            "REJECTED"
          ]
        },
        "rejectionReasons": {
          "type": "array",
          "items": {
            "enum": [
              "NON_MANIFOLD_SHELL",
              "NON_MANIFOLD_EDGE",
              "AMBIGUOUS_EDGE_INCIDENCE",
              "MULTIPLE_SHELLS",
              "ZERO_OR_ONE_PORT",
              "FOUR_PLUS_PORT",
              "AMBIGUOUS_PORT_REGION",
              "DEGENERATE_LOOP",
              "OPEN_CHAIN",
              "BRANCHING_BOUNDARY",
              "AMBIGUOUS_WINDING",
              "LOCAL_WINDING_DEGENERATE",
              "LOCAL_FIT_SINGULAR",
              "RADIUS_BELOW_MINIMUM",
              "UNSUPPORTED_INHERITANCE",
              "MISSING_TRANSFORM",
              "SINGULAR_TRANSFORM",
              "SHEAR_TRANSFORM",
              "NON_UNIFORM_SCALE",
              "MIRRORED_ORIENTATION_MISMATCH",
              "NON_PLANAR",
              "NON_CIRCULAR",
              "NON_FINITE_RESULT"
            ]
          }
        }
      }
    },
    "occurrenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceOccurrenceId",
        "sourceModelObjectId",
        "geometryObjectId",
        "shellId",
        "analysisProjection",
        "topologyDisposition",
        "candidates",
        "rejectionReasons"
      ],
      "properties": {
        "sourceOccurrenceId": {
          "type": "string",
          "pattern": "^occ:[0-9]+$"
        },
        "sourceModelObjectId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "geometryObjectId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "shellId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^shell:[0-9a-f]{64}$"
            }
          ]
        },
        "analysisProjection": {
          "$ref": "#/$defs/analysisProjection"
        },
        "topologyDisposition": {
          "enum": [
            "STRAIGHT_TWO_PORT",
            "BENT_TWO_PORT",
            "TAPERED_TWO_PORT",
            "SHORT_TWO_PORT",
            "THREE_PORT",
            "REJECTED"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "rejectionReasons": {
          "type": "array",
          "items": {
            "enum": [
              "NON_MANIFOLD_SHELL",
              "NON_MANIFOLD_EDGE",
              "AMBIGUOUS_EDGE_INCIDENCE",
              "MULTIPLE_SHELLS",
              "ZERO_OR_ONE_PORT",
              "FOUR_PLUS_PORT",
              "AMBIGUOUS_PORT_REGION",
              "DEGENERATE_LOOP",
              "OPEN_CHAIN",
              "BRANCHING_BOUNDARY",
              "AMBIGUOUS_WINDING",
              "LOCAL_WINDING_DEGENERATE",
              "LOCAL_FIT_SINGULAR",
              "RADIUS_BELOW_MINIMUM",
              "UNSUPPORTED_INHERITANCE",
              "MISSING_TRANSFORM",
              "SINGULAR_TRANSFORM",
              "SHEAR_TRANSFORM",
              "NON_UNIFORM_SCALE",
              "MIRRORED_ORIENTATION_MISMATCH",
              "NON_PLANAR",
              "NON_CIRCULAR",
              "NON_FINITE_RESULT"
            ]
          }
        }
      }
    }
  }
}
