{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reallaksh19/3D_Converters/contracts/fbx/fbx-selected-zone-diagnostic-ledger.v1.schema.json",
  "title": "FbxSelectedZoneDiagnosticLedger.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "selectedZoneDigest", "manifestDigest", "entries", "summary", "ledgerDigest"],
  "properties": {
    "schema": { "const": "FbxSelectedZoneDiagnosticLedger.v1" },
    "selectedZoneDigest": { "$ref": "#/$defs/sha256" },
    "manifestDigest": { "$ref": "#/$defs/sha256" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalGeometries", "countsByDisposition"],
      "properties": {
        "totalGeometries": { "type": "integer", "minimum": 1 },
        "countsByDisposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CLOSED", "CAPPED", "MERGED", "MULTI_SHELL", "INVALID_TOPOLOGY", "OTHER_GOVERNED"],
          "properties": {
            "CLOSED": { "type": "integer", "minimum": 0 },
            "CAPPED": { "type": "integer", "minimum": 0 },
            "MERGED": { "type": "integer", "minimum": 0 },
            "MULTI_SHELL": { "type": "integer", "minimum": 0 },
            "INVALID_TOPOLOGY": { "type": "integer", "minimum": 0 },
            "OTHER_GOVERNED": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "ledgerDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decimalId": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "maxLength": 20 },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["polygonCount", "boundaryEdgeCount", "shellCount", "boundaryLoopCount"],
      "properties": {
        "polygonCount": { "type": "integer", "minimum": 0 },
        "boundaryEdgeCount": { "type": "integer", "minimum": 0 },
        "shellCount": { "type": "integer", "minimum": 0 },
        "boundaryLoopCount": { "type": "integer", "minimum": 0 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometryId", "occurrenceId", "disposition", "reasonCode", "stats"],
      "properties": {
        "geometryId": { "$ref": "#/$defs/decimalId" },
        "occurrenceId": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["CLOSED", "CAPPED", "MERGED", "MULTI_SHELL", "INVALID_TOPOLOGY", "OTHER_GOVERNED"] },
        "reasonCode": { "type": "string", "minLength": 1 },
        "stats": { "$ref": "#/$defs/stats" }
      }
    }
  }
}
