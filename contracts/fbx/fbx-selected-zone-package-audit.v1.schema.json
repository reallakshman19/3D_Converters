{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reallaksh19/3D_Converters/contracts/fbx/fbx-selected-zone-package-audit.v1.schema.json",
  "title": "FbxSelectedZonePackageAudit.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifestSha256", "fileRoles", "supportSemantics", "geometryCount", "packageDigest"],
  "properties": {
    "schema": { "const": "FbxSelectedZonePackageAudit.v1" },
    "manifestSha256": { "$ref": "#/$defs/sha256" },
    "fileRoles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/fileRole" }
    },
    "supportSemantics": { "enum": ["NOT_AUTHORIZED", "CANDIDATE_EVIDENCE_ONLY"] },
    "geometryCount": { "type": "integer", "minimum": 1, "maximum": 20000 },
    "packageDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "disposition", "sha256"],
      "properties": {
        "role": { "enum": ["MANIFEST", "STAGEDJSON", "SUPPORT_EVIDENCE"] },
        "path": { "type": "string", "enum": ["manifest.json", "stagedjson.json", "support-evidence.json"] },
        "disposition": { "enum": ["PRESENT", "OMITTED_BLOCKED"] },
        "sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "PRESENT" } } },
          "then": { "properties": { "sha256": { "$ref": "#/$defs/sha256" } } }
        },
        {
          "if": { "properties": { "disposition": { "const": "OMITTED_BLOCKED" } } },
          "then": { "properties": { "sha256": { "type": "null" } } }
        }
      ]
    }
  }
}
