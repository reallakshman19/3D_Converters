{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FbxComponentIdentityPolicy.v1",
  "title": "FbxComponentIdentityPolicy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "policyId", "authorityState", "typeCatalog", "identityRules",
    "collisionPolicy", "cardinalityPolicy", "unknownTypePolicy", "policyContentSha256"
  ],
  "properties": {
    "schema": { "const": "FbxComponentIdentityPolicy.v1" },
    "policyId": { "$ref": "#/$defs/nonEmptyString" },
    "authorityState": { "enum": ["DRAFT", "FROZEN", "RETIRED"] },
    "typeCatalog": {
      "type": "array",
      "items": { "$ref": "#/$defs/typeCatalogEntry" },
      "minItems": 1
    },
    "identityRules": {
      "type": "array",
      "items": { "$ref": "#/$defs/identityRule" },
      "minItems": 1
    },
    "collisionPolicy": { "$ref": "#/$defs/collisionPolicy" },
    "cardinalityPolicy": { "$ref": "#/$defs/cardinalityPolicy" },
    "unknownTypePolicy": { "const": "BLOCKED_IDENTITY" },
    "policyContentSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "authorityState": { "const": "FROZEN" } } },
      "then": { "properties": { "policyContentSha256": { "$ref": "#/$defs/sha256" } } }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "family": {
      "enum": [
        "PIPE", "ELBOW", "TEE", "REDUCER", "FLANGE", "VALVE",
        "GASKET", "BRANCH_FITTING", "INSTRUMENT"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "typeCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familyId", "outerTypes", "rawTypes", "preserveRawSubtype",
        "disposition", "comparatorId", "exclusionReason"
      ],
      "properties": {
        "familyId": { "$ref": "#/$defs/family" },
        "outerTypes": {
          "allOf": [
            { "$ref": "#/$defs/stringArray" },
            { "minItems": 1 }
          ]
        },
        "rawTypes": { "$ref": "#/$defs/stringArray" },
        "preserveRawSubtype": { "type": "boolean" },
        "disposition": { "enum": ["QUALIFY", "EXCLUDE_WITH_REASON", "BLOCK"] },
        "comparatorId": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "exclusionReason": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "QUALIFY" } } },
          "then": {
            "properties": {
              "comparatorId": { "$ref": "#/$defs/nonEmptyString" },
              "exclusionReason": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "disposition": { "const": "EXCLUDE_WITH_REASON" } } },
          "then": {
            "properties": {
              "comparatorId": { "type": "null" },
              "exclusionReason": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        {
          "if": { "properties": { "disposition": { "const": "BLOCK" } } },
          "then": {
            "properties": {
              "comparatorId": { "type": "null" },
              "exclusionReason": { "type": "null" }
            }
          }
        }
      ]
    },
    "identityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId", "rank", "kind", "applicableFamilies", "requiredFields",
        "normalizationRuleIds", "scope", "uniquenessRequirement", "passing"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/nonEmptyString" },
        "rank": { "type": "integer", "minimum": 1 },
        "kind": {
          "enum": [
            "EXACT", "APPROVED_COMPOSITE",
            "DIAGNOSTIC_STRUCTURAL", "DIAGNOSTIC_SPATIAL"
          ]
        },
        "applicableFamilies": {
          "type": "array",
          "items": { "$ref": "#/$defs/family" },
          "minItems": 1,
          "uniqueItems": true
        },
        "requiredFields": {
          "allOf": [
            { "$ref": "#/$defs/stringArray" },
            { "minItems": 1 }
          ]
        },
        "normalizationRuleIds": { "$ref": "#/$defs/stringArray" },
        "scope": { "enum": ["GLOBAL", "ZONE", "OWNER", "BRANCH"] },
        "uniquenessRequirement": { "enum": ["EXACTLY_ONE", "COLLISION_PRESERVING"] },
        "passing": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "enum": ["DIAGNOSTIC_STRUCTURAL", "DIAGNOSTIC_SPATIAL"] }
            }
          },
          "then": { "properties": { "passing": { "const": false } } }
        },
        {
          "if": { "properties": { "scope": { "const": "ZONE" } } },
          "then": { "properties": { "requiredFields": { "contains": { "const": "zoneId" } } } }
        },
        {
          "if": { "properties": { "scope": { "const": "OWNER" } } },
          "then": { "properties": { "requiredFields": { "contains": { "const": "owner" } } } }
        },
        {
          "if": { "properties": { "scope": { "const": "BRANCH" } } },
          "then": { "properties": { "requiredFields": { "contains": { "const": "branchId" } } } }
        }
      ]
    },
    "collisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indexShape", "preserveAllSubjects", "mergeDuplicates",
        "greedyResolutionAllowed", "ambiguousState", "blockedState"
      ],
      "properties": {
        "indexShape": { "const": "MULTIMAP" },
        "preserveAllSubjects": { "const": true },
        "mergeDuplicates": { "const": false },
        "greedyResolutionAllowed": { "const": false },
        "ambiguousState": { "const": "AMBIGUOUS_MATCH" },
        "blockedState": { "const": "BLOCKED_IDENTITY" }
      }
    },
    "cardinalityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumPassingCounterpartsPerReference",
        "maximumPassingCounterpartsPerActual",
        "atomicReservationRequired"
      ],
      "properties": {
        "maximumPassingCounterpartsPerReference": { "const": 1 },
        "maximumPassingCounterpartsPerActual": { "const": 1 },
        "atomicReservationRequired": { "const": true }
      }
    }
  }
}
