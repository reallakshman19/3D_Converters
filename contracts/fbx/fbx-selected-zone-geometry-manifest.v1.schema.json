{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reallaksh19/3D_Converters/contracts/fbx/fbx-selected-zone-geometry-manifest.v1.schema.json",
  "title": "FbxSelectedZoneGeometryManifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "completeSourceGraphSha256",
    "selectedZoneDigest",
    "sourceIdentity",
    "geometries",
    "manifestDigest"
  ],
  "properties": {
    "schema": { "const": "FbxSelectedZoneGeometryManifest.v1" },
    "completeSourceGraphSha256": { "$ref": "#/$defs/sha256" },
    "selectedZoneDigest": { "$ref": "#/$defs/sha256" },
    "sourceIdentity": { "$ref": "#/$defs/sourceIdentity" },
    "geometries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/geometry" }
    },
    "manifestDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decimalId": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "maxLength": 20 },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byteLength", "fbxVersion"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "fbxVersion": { "type": "integer", "minimum": 3000, "maximum": 7700 }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometryId", "sourceObjectId", "occurrenceId", "controlPointCount",
        "polygonCount", "packagePath", "buffers"
      ],
      "properties": {
        "geometryId": { "$ref": "#/$defs/decimalId" },
        "sourceObjectId": { "$ref": "#/$defs/decimalId" },
        "occurrenceId": { "type": "string", "minLength": 1 },
        "controlPointCount": { "type": "integer", "minimum": 0 },
        "polygonCount": { "type": "integer", "minimum": 0 },
        "packagePath": { "type": "string", "pattern": "^geometries/(0|[1-9][0-9]{0,19})/geometry\\.json$" },
        "buffers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/buffer" }
        }
      }
    },
    "buffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "scalarType", "componentCount", "count", "byteLength", "sha256", "packagePath"],
      "properties": {
        "role": { "enum": ["control-points-mm", "polygon-offsets", "polygon-vertex-indices"] },
        "scalarType": { "enum": ["Float64", "Uint32"] },
        "componentCount": { "enum": [1, 3] },
        "count": { "type": "integer", "minimum": 0 },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "packagePath": { "type": "string", "pattern": "^geometries/(0|[1-9][0-9]{0,19})/(control-points-mm|polygon-offsets|polygon-vertex-indices)\\.bin$" }
      }
    }
  }
}
