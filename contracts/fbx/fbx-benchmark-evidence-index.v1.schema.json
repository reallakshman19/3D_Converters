{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FbxBenchmarkEvidenceIndex.v1",
  "title": "FbxBenchmarkEvidenceIndex.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmarkIdentity",
    "executionIdentity",
    "artifacts",
    "countsByStatus",
    "rootDigestRule",
    "canonicalOrdering",
    "rootEvidenceSha256"
  ],
  "properties": {
    "schema": { "const": "FbxBenchmarkEvidenceIndex.v1" },
    "benchmarkIdentity": { "type": "object" },
    "executionIdentity": { "type": "object" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "countsByStatus": { "$ref": "#/$defs/statusCounts" },
    "rootDigestRule": { "const": "SHA256_CANONICAL_JSON_WITHOUT_ROOT_FIELD" },
    "canonicalOrdering": {
      "prefixItems": [
        { "const": "artifactId" },
        { "const": "artifactType" },
        { "const": "relativePath" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "rootEvidenceSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": {
      "enum": ["PASS", "PASS_WITH_OBSERVATIONS", "FAIL", "BLOCKED", "NOT_EXECUTED"]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactType",
        "artifactSchema",
        "relativePath",
        "mediaType",
        "qualificationStatus",
        "contentSha256",
        "byteLength"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "artifactType": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "artifactSchema": { "$ref": "#/$defs/nonEmptyString" },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*\\\\).+(?<!/)$"
        },
        "mediaType": { "const": "application/json" },
        "qualificationStatus": { "$ref": "#/$defs/status" },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1 }
      }
    },
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASS", "PASS_WITH_OBSERVATIONS", "FAIL", "BLOCKED", "NOT_EXECUTED"],
      "properties": {
        "PASS": { "type": "integer", "minimum": 0 },
        "PASS_WITH_OBSERVATIONS": { "type": "integer", "minimum": 0 },
        "FAIL": { "type": "integer", "minimum": 0 },
        "BLOCKED": { "type": "integer", "minimum": 0 },
        "NOT_EXECUTED": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
