{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TopoEnrichedXmlCiiProjectionLedger.v1",
  "title": "TopoEnrichedXmlCiiProjectionLedger.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "chain",
    "authority",
    "summary",
    "lossAccounting",
    "records",
    "diagnostics",
    "projectionLedgerHashSha256"
  ],
  "properties": {
    "schema": {
      "const": "TopoEnrichedXmlCiiProjectionLedger.v1"
    },
    "status": {
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    },
    "chain": {
      "type": "object",
      "minProperties": 15,
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "authority": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "emittedOccurrenceCount",
        "reservedOccurrenceCount",
        "projectedOccurrenceCount",
        "intentionallyOmittedOccurrenceCount",
        "blockedOccurrenceCount",
        "nodeNumberMismatchCount",
        "unaccountedOccurrenceCount"
      ],
      "properties": {
        "emittedOccurrenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "reservedOccurrenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "projectedOccurrenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "intentionallyOmittedOccurrenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "blockedOccurrenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "nodeNumberMismatchCount": {
          "type": "integer",
          "minimum": 0
        },
        "unaccountedOccurrenceCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lossAccounting": {
      "$ref": "#/$defs/lossAccounting"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "projectionLedgerHashSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "lossAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projected",
        "intentionallyOmitted",
        "defaulted",
        "blocked",
        "reserved",
        "unexplained"
      ],
      "properties": {
        "projected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intentionallyOmitted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaulted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unexplained": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "recordId",
        "occurrenceId",
        "sourceDisposition",
        "disposition",
        "logicalNodeId",
        "engineeringNodeNumber",
        "componentProjectionId",
        "componentType",
        "projectionRule",
        "governingPolicyHashSha256",
        "evidence"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "minLength": 1
        },
        "occurrenceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceDisposition": {
          "enum": [
            "EMITTED",
            "RESERVED"
          ]
        },
        "disposition": {
          "enum": [
            "PROJECTED",
            "INTENTIONALLY_OMITTED_BRANCH_BOUNDARY",
            "INTENTIONALLY_OMITTED_ISOLATED_NODE",
            "RESERVED",
            "BLOCKED"
          ]
        },
        "logicalNodeId": {
          "type": "string",
          "minLength": 1
        },
        "historyNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "engineeringNodeNumber": {
          "type": "integer",
          "minimum": 1
        },
        "sourceEntityId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourcePortIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "componentProjectionId": {
          "type": "string",
          "minLength": 1
        },
        "componentType": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "branchName": {
          "type": [
            "string",
            "null"
          ]
        },
        "psiBranchIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "psiNodeIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "canonicalElementId": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonicalElementIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "ciiElementIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "projectionRule": {
          "type": "string",
          "minLength": 1
        },
        "governingPolicyHashSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence": {
          "type": "object"
        }
      }
    }
  }
}
